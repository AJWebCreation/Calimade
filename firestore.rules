rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }
    
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt'])
        && data.keys().size() == 3
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.createdAt == request.time;
    }
    
    function isValidUserUpdate(data) {
      return data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && (!data.keys().hasAny(['goal']) || (data.goal is string && data.goal.size() <= 500))
        && (!data.keys().hasAny(['level']) || (data.level is string && data.level.size() <= 100))
        && (!data.keys().hasAny(['hasCompletedSurvey']) || data.hasCompletedSurvey is bool)
        && (!data.keys().hasAny(['coachAdvice']) || (data.coachAdvice is string && data.coachAdvice.size() <= 50000));
    }

    function isModerator() { 
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u != null && u.data.displayName == '@Ajcali';
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserUpdate(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'goal', 'level', 'hasCompletedSurvey', 'coachAdvice']) && incoming().createdAt == existing().createdAt;
      allow delete: if false;
      
      match /logs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId) && isValidId(userId);
        
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(logId)
          && incoming().keys().hasAll(['name', 'dur', 'exercises', 'date', 'timestamp', 'userId'])
          && incoming().userId == userId
          && incoming().name is string && incoming().name.size() <= 200
          && incoming().dur is number
          && incoming().exercises is number
          && incoming().date is string && incoming().date.size() <= 50
          && incoming().timestamp is number;
          
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(logId)
          && incoming().userId == existing().userId
          && incoming().name is string && incoming().name.size() <= 200
          && incoming().dur is number
          && incoming().exercises is number
          && incoming().date is string && incoming().date.size() <= 50
          && incoming().timestamp is number;
          
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      }
      
      match /routine/{routineId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow write: if isOwner(userId) && isValidId(userId) && isValidId(routineId)
          && incoming().userId == userId
          && incoming().days is list;
      }
      
      match /customCircuits/{docId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow write: if isOwner(userId) && isValidId(userId) && isValidId(docId)
          && incoming().userId == userId
          && incoming().circuits is list;
      }
    }
    
    match /communityPosts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() && isValidId(postId)
        && incoming().authorId == request.auth.uid
        && incoming().author is string && incoming().author.size() <= 100
        && incoming().initials is string && incoming().initials.size() <= 5
        && incoming().avatarColor is string && incoming().avatarColor.size() <= 50
        && incoming().text is string && incoming().text.size() <= 1000
        && incoming().time is string && incoming().time.size() <= 50
        && incoming().timestamp is number
        && incoming().likes is number
        && incoming().likedBy is list
        && incoming().comments is list;
        
      allow update: if isSignedIn() && isValidId(postId)
        && (
          (existing().authorId == request.auth.uid && incoming().authorId == existing().authorId) || 
          isModerator() ||
          (incoming().authorId == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy', 'comments'])
            && incoming().likes is number
            && incoming().likedBy is list
            && incoming().comments is list)
        );
        
      allow delete: if isSignedIn() && isValidId(postId) && (existing().authorId == request.auth.uid || isModerator());
    }
  }
}
